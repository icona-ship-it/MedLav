name: Weekly DB Backup → R2

# Off-site backup settimanale del DB Supabase verso Cloudflare R2 (EU storage).
# Cifra: aws CLI usa TLS verso R2 endpoint. R2 ha encryption-at-rest by default.
# Retention: 12 settimane (3 mesi) — controllato dal script via $BACKUP_RETENTION_WEEKS.
#
# Trigger: cron domenica 03:00 UTC + manual dispatch per test.

on:
  schedule:
    # Ogni domenica alle 03:00 UTC (orario basso traffico)
    - cron: '0 3 * * 0'
  workflow_dispatch: # Permette esecuzione manuale dalla UI Actions

jobs:
  backup:
    name: pg_dump → R2
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install pg_dump 16 (match Supabase Postgres version)
        run: |
          sudo apt-get update
          sudo apt-get install -y wget ca-certificates
          # Postgres APT repo per pg_dump 16
          wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo apt-key add -
          echo "deb http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list
          sudo apt-get update
          sudo apt-get install -y postgresql-client-16
          pg_dump --version

      - name: Install aws CLI (for R2 S3-compat upload)
        run: |
          curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
          unzip -q awscliv2.zip
          sudo ./aws/install --update
          aws --version

      - name: Run backup script
        env:
          SUPABASE_DB_URL: ${{ secrets.SUPABASE_DB_URL }}
          R2_ACCESS_KEY: ${{ secrets.R2_ACCESS_KEY }}
          R2_SECRET_KEY: ${{ secrets.R2_SECRET_KEY }}
          R2_BUCKET: ${{ secrets.R2_BUCKET }}
          R2_ENDPOINT: ${{ secrets.R2_ENDPOINT }}
          BACKUP_RETENTION_WEEKS: '12'
        run: |
          chmod +x scripts/backup-db.sh
          ./scripts/backup-db.sh

      - name: Notify on failure
        if: failure()
        run: |
          echo "❌ Backup failed. Check Sentry alerts or Vercel logs."
          # TODO: integrare Slack webhook quando configurato (vedi docs/SENTRY-ALERTS.md)
